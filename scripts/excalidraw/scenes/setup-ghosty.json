r": "#c9c9cc", "strokeWidth": 4, "roughness": 1, "fillStyle": "solid", "groupIds": ["adaa0c4a9450"]}, {"type": "ellipse", "x": 1396.8695652173913, "y": 37.73913043478261, "width": 63.565217391304344, "height": 59.13043478260869, "backgroundColor": "transparent", "strokeColor": "#c9c9cc", "strokeWidth": 4, "roughness": 1, "fillStyle": "solid", "groupIds": ["adaa0c4a9450"]}, {"type": "line", "x": 1389.4782608695652, "y": 58.43478260869565, "points": [[0, 0], [4.434782608695652, -4.434782608695652], [8.869565217391305, 0]], "strokeColor": "#c9c9cc", "strokeWidth": 4, "roughness": 1, "fillStyle": "solid", "groupIds": ["adaa0c4a9450"]}, {"type": "line", "x": 1327.391304347826, "y": 64.34782608695652, "points": [[0, 0], [-7.391304347826086, 1.4782608695652173]], "strokeColor": "#c9c9cc", "strokeWidth": 4, "roughness": 1, "fillStyle": "solid", "groupIds": ["adaa0c4a9450"]}, {"type": "line", "x": 1460.4347826086957, "y": 64.34782608695652, "points": [[0, 0], [7.391304347826086, 1.4782608695652173]], "strokeColor": "#c9c9cc", "strokeWidth": 4, "roughness": 1, "fillStyle": "solid", "groupIds": ["adaa0c4a9450"]}, {"type": "rectangle", "x": 120, "y": 200, "width": 1400, "height": 150, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 4, "roundness": {"type": 3}}, {"type": "text", "x": 145, "y": 212, "fontSize": 32, "fontFamily": 1, "text": "01  Borra los ghostys viejos", "strokeColor": "#c92a2a"}, {"type": "text", "x": 160, "y": 258, "fontSize": 26, "fontFamily": 3, "text": "rm -f ~/.local/bin/ghosty\nrm -rf ~/.ghosty", "strokeColor": "#212529"}, {"type": "text", "x": 160, "y": 318, "fontSize": 20, "fontFamily": 1, "text": "si lo instalaste en otro taller, esa versión arranca en lugar de la nueva. which -a ghosty no debe imprimir nada", "strokeColor": "#495057"}, {"type": "rectangle", "x": 120, "y": 372, "width": 1400, "height": 130, "backgroundColor": "#e5dbff", "strokeColor": "#6741d9", "fillStyle": "solid", "strokeWidth": 4, "roundness": {"type": 3}}, {"type": "text", "x": 145, "y": 384, "fontSize": 32, "fontFamily": 1, "text": "02  Instala GhostyCode", "strokeColor": "#6741d9"}, {"type": "text", "x": 160, "y": 430, "fontSize": 26, "fontFamily": 3, "text": "curl -fsSL https://formmy.app/ghosty/install.sh | sh", "strokeColor": "#212529"}, {"type": "text", "x": 160, "y": 470, "fontSize": 20, "fontFamily": 1, "text": "binario precompilado, sin Node ni Rust. También: npm install -g ghostycode", "strokeColor": "#495057"}, {"type": "rectangle", "x": 120, "y": 524, "width": 1400, "height": 130, "backgroundColor": "#ffd8a8", "strokeColor": "#e8590c", "fillStyle": "solid", "strokeWidth": 4, "roundness": {"type": 3}}, {"type": "text", "x": 145, "y": 536, "fontSize": 32, "fontFamily": 1, "text": "03  Conecta tu key de EasyBits", "strokeColor": "#e8590c"}, {"type": "text", "x": 160, "y": 582, "fontSize": 26, "fontFamily": 3, "text": "ghosty auth set --provider easybits --api-key TU_KEY", "strokeColor": "#212529"}, {"type": "text", "x": 160, "y": 622, "fontSize": 20, "fontFamily": 1, "text": "la key se crea en tu cuenta de EasyBits (panel de desarrollador); queda en tu config", "strokeColor": "#495057"}, {"type": "rectangle", "x": 120, "y": 676, "width": 1400, "height": 150, "backgroundColor": "#d0ebff", "strokeColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 4, "roundness": {"type": 3}}, {"type": "text", "x": 145, "y": 688, "fontSize": 32, "fontFamily": 1, "text": "04  Conecta las sandboxes", "strokeColor": "#1971c2"}, {"type": "text", "x": 160, "y": 734, "fontSize": 26, "fontFamily": 3, "text": "ghosty mcp add easybits --url \"https://www.easybits.cloud/api/mcp/sandbox\"\nghosty mcp login easybits", "strokeColor": "#212529"}, {"type": "text", "x": 160, "y": 794, "fontSize": 20, "fontFamily": 1, "text": "son las cajas donde corre el agente; login abre el navegador y autorizas", "strokeColor": "#495057"}, {"type": "rectangle", "x": 120, "y": 848, "width": 1400, "height": 130, "backgroundColor": "#d3f9d8", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 4, "roundness": {"type": 3}}, {"type": "text", "x": 145, "y": 860, "fontSize": 32, "fontFamily": 1, "text": "05  Arranca", "strokeColor": "#2f9e44"}, {"type": "text", "x": 160, "y": 906, "fontSize": 26, "fontFamily": 3, "text": "ghosty --yolo", "strokeColor": "#212529"}, {"type": "text", "x": 160, "y": 946, "fontSize": 20, "fontFamily": 1, "text": "pídele algo; si responde, listo para la sesión 1. --yolo ejecuta sin pedir permiso en cada paso", "strokeColor": "#495057"}, {"type": "text", "x": 300, "y": 1020, "fontSize": 34, "fontFamily": 1, "text": "💡 el paso 1 no es opcional: el ghosty viejo gana en el PATH y te confunde toda la sesión.", "strokeColor": "#e67700"}]}