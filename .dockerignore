# El contexto se sube entero al builder remoto: cada MB son segundos por deploy.
# Solo se excluye lo que con certeza no participa del build — excluir de más
# rompe la compilación de formas difíciles de leer desde los logs remotos.
.git
.github
.claude
node_modules
build
.react-router

# Salidas y trabajo local
videos
taller-arnes-grok
coverage
.DS_Store
.vscode
.idea

# Secretos: las variables llegan por el entorno de Fly, nunca en la imagen
.env
.env.*
!.env.example
